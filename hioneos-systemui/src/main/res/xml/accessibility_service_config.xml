<?xml version="1.0" encoding="utf-8"?>
<!--
  The navigation service. It draws the gesture overlays, performs global actions and dispatches
  gestures. It NEVER reads window content: there is no rootInActiveWindow, no AccessibilityNodeInfo,
  anywhere in it.

  It used to declare canRetrieveWindowContent="true" with typeAllMask and
  flagRetrieveInteractiveWindows anyway. That single line told every app on the device that an
  accessibility service wanted its content, so every Compose screen built and re-walked its full
  semantics tree on every layout pass to have it ready. In a sampling profile of Hione Music
  scrolling the artist list (2026-09-19), findAllSemanticNodesRecursive was the single hottest
  self-time frame on the UI thread, ahead of measure, layout and draw. That cost was paid by the
  player, the launcher and every third-party app, for content nobody ever asked for.

  Now: no content retrieval, and only the four event types the service actually handles.

  isAccessibilityTool="true": on Android 14 a window an app marks accessibilityDataSensitive
  (password fields, payment sheets) only accepts injected input from services that declare
  themselves accessibility tools. Without it, a tap the top strip or the pill replays into such
  a window is dropped. This service is navigation, which is what the flag is for.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewClicked|typeViewLongClicked|typeGestureDetectionStart"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="false"
    android:canPerformGestures="true"
    android:isAccessibilityTool="true"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/app_name"
    android:notificationTimeout="100" />
