package com.hione.launcher.gesture
import com.hione.launcher.*

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.Service
import android.content.Context
import android.content.Intent
import android.graphics.*
import android.hardware.input.InputManager
import android.os.Build
import android.os.IBinder
import android.os.SystemClock
import android.view.Gravity
import android.view.KeyEvent
import android.view.MotionEvent
import android.view.View
import android.view.WindowManager
import com.hione.launcher.R
import com.hione.launcher.RootShell
import com.hione.launcher.HioneLauncherActivity
import com.hione.launcher.haptics.HioneTactileHaptics
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch

/**
 * Hatsune Hione System-Wide Pixel-Style Gesture Navigation Overlay Service.
 * Provides hardware-accelerated side-edge back swipes (with animated chevron feedback)
 * and a bottom gesture bar (Home, Recents, Quick Switch) running persistently above all apps.
 */
class HioneSystemGestureService : Service() {

    private var windowManager: WindowManager? = null
    private var gesturePillView: GesturePillView? = null
    private var topShadeInterceptView: View? = null
    private var leftEdgeView: EdgeBackView? = null
    private var rightEdgeView: EdgeBackView? = null

    companion object {
        private const val TAG = "HioneGestureNav"
        private const val NOTIF_ID = 1339
        private const val CHANNEL_ID = "hione_gesture_nav_channel"

        fun start(context: Context) {
            val appCtx = context.applicationContext
            CoroutineScope(Dispatchers.IO).launch {
                RootShell.execFast(
                    "appops set com.hione.launcher SYSTEM_ALERT_WINDOW allow; " +
                    "appops set com.hione.player SYSTEM_ALERT_WINDOW allow; " +
                    "appops set com.hione.systemui SYSTEM_ALERT_WINDOW allow; " +
                    "setprop qemu.hw.mainkeys 1; " +
                    "settings put global policy_control immersive.full=*; " +
                    "settings put secure navigation_mode 0; " +
                    "settings put secure back_gesture_inset_scale_left 0; " +
                    "settings put secure back_gesture_inset_scale_right 0"
                )
                try {
                    val intent = Intent(appCtx, HioneSystemGestureService::class.java)
                    appCtx.startService(intent)
                } catch (_: Throwable) {}
            }
        }

        fun stop(context: Context) {
            try {
                context.stopService(Intent(context, HioneSystemGestureService::class.java))
            } catch (_: Throwable) {}
        }
    }

    override fun onCreate() {
        super.onCreate()
        setupGestureOverlay()
        setupTopShadeOverlay()
        setupEdgeBackOverlays()
        try { com.hione.launcher.volume.HioneVolumeManager.init(this) } catch (_: Throwable) {}
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        return START_STICKY
    }



    private fun getOverlayType(): Int {
        return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
        } else {
            @Suppress("DEPRECATION")
            WindowManager.LayoutParams.TYPE_PHONE
        }
    }

    private fun setupTopShadeOverlay() {
        val wm = windowManager ?: (getSystemService(Context.WINDOW_SERVICE) as WindowManager).also { windowManager = it }
        val density = resources.displayMetrics.density
        val topBarHeightPx = (24 * density).toInt()

        val params = WindowManager.LayoutParams(
            WindowManager.LayoutParams.MATCH_PARENT,
            topBarHeightPx,
            getOverlayType(),
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
            PixelFormat.TRANSLUCENT
        ).apply {
            gravity = Gravity.TOP or Gravity.CENTER_HORIZONTAL
            x = 0
            y = 0
        }

        val topView = View(this).apply {
            var startY = 0f
            var isSwipeDetected = false
            setOnTouchListener { _, event ->
                when (event.actionMasked) {
                    MotionEvent.ACTION_DOWN -> {
                        startY = event.rawY
                        isSwipeDetected = false
                        true
                    }
                    MotionEvent.ACTION_MOVE -> {
                        val dy = event.rawY - startY
                        if (dy > 20 * density && !isSwipeDetected) {
                            isSwipeDetected = true
                            HioneTactileHaptics.playRatchetTick(this@HioneSystemGestureService)
                            triggerOpenShade()
                            true
                        } else {
                            true
                        }
                    }
                    MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
                        isSwipeDetected = false
                        false
                    }
                    else -> false
                }
            }
        }
        topShadeInterceptView = topView
        try {
            wm.addView(topView, params)
        } catch (_: Throwable) {}
    }

    private fun triggerOpenShade() {
        try {
            val intent = Intent().setClassName("com.hione.systemui", "com.hione.systemui.HioneShadeActivity").apply {
                flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP
            }
            startActivity(intent)
        } catch (_: Throwable) {
            try {
                val intent = packageManager.getLaunchIntentForPackage("com.hione.systemui")
                if (intent != null) startActivity(intent)
            } catch (_: Throwable) {}
        }
    }

    private fun setupGestureOverlay() {
        val wm = windowManager ?: (getSystemService(Context.WINDOW_SERVICE) as WindowManager).also { windowManager = it }
        val density = resources.displayMetrics.density
        val barHeightPx = (32 * density).toInt()

        val params = WindowManager.LayoutParams(
            WindowManager.LayoutParams.MATCH_PARENT,
            barHeightPx,
            getOverlayType(),
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
                WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
            PixelFormat.TRANSLUCENT
        ).apply {
            gravity = Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL
            y = 0
        }

        val view = GesturePillView(this) { action ->
            when (action) {
                GestureAction.HOME -> triggerHome()
                GestureAction.RECENTS -> triggerRecents()
                GestureAction.QUICK_SWITCH -> injectKey(KeyEvent.KEYCODE_APP_SWITCH)
            }
        }
        gesturePillView = view

        try {
            wm.addView(view, params)
        } catch (t: Throwable) {
            android.util.Log.e(TAG, "Failed to add gesture pill overlay", t)
        }
    }

    private fun setupEdgeBackOverlays() {
        val wm = windowManager ?: (getSystemService(Context.WINDOW_SERVICE) as WindowManager).also { windowManager = it }
        val density = resources.displayMetrics.density
        val edgeWidthPx = (32 * density).toInt()

        // Left Edge Back Overlay
        val leftParams = WindowManager.LayoutParams(
            edgeWidthPx,
            WindowManager.LayoutParams.MATCH_PARENT,
            getOverlayType(),
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
                WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
            PixelFormat.TRANSLUCENT
        ).apply {
            gravity = Gravity.START or Gravity.CENTER_VERTICAL
            x = 0
            y = 0
        }

        val leftView = EdgeBackView(this, isLeft = true) {
            triggerBack()
        }
        leftEdgeView = leftView
        try {
            wm.addView(leftView, leftParams)
        } catch (_: Throwable) {}

        // Right Edge Back Overlay
        val rightParams = WindowManager.LayoutParams(
            edgeWidthPx,
            WindowManager.LayoutParams.MATCH_PARENT,
            getOverlayType(),
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
                WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
            PixelFormat.TRANSLUCENT
        ).apply {
            gravity = Gravity.END or Gravity.CENTER_VERTICAL
            x = 0
            y = 0
        }

        val rightView = EdgeBackView(this, isLeft = false) {
            triggerBack()
        }
        rightEdgeView = rightView
        try {
            wm.addView(rightView, rightParams)
        } catch (_: Throwable) {}
    }

    private fun injectKey(keyCode: Int) {
        val now = SystemClock.uptimeMillis()
        try {
            val im = getSystemService(Context.INPUT_SERVICE) as? InputManager
            if (im != null) {
                val method = InputManager::class.java.getMethod(
                    "injectInputEvent",
                    android.view.InputEvent::class.java,
                    Int::class.javaPrimitiveType
                )
                val down = KeyEvent(now, now, KeyEvent.ACTION_DOWN, keyCode, 0)
                val up = KeyEvent(now, now, KeyEvent.ACTION_UP, keyCode, 0)
                method.invoke(im, down, 0)
                method.invoke(im, up, 0)
                return
            }
        } catch (_: Throwable) {}

        try {
            Thread {
                try {
                    android.app.Instrumentation().sendKeyDownUpSync(keyCode)
                } catch (_: Throwable) {}
            }.start()
        } catch (_: Throwable) {}

        try {
            Runtime.getRuntime().exec(arrayOf("input", "keyevent", keyCode.toString()))
        } catch (_: Throwable) {}

        RootShell.execFast("input keyevent $keyCode")
    }

    private fun triggerHome() {
        injectKey(KeyEvent.KEYCODE_HOME)
        val intent = Intent(Intent.ACTION_MAIN).apply {
            addCategory(Intent.CATEGORY_HOME)
            flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED
        }
        try {
            val opts = android.app.ActivityOptions.makeCustomAnimation(
                this,
                android.R.anim.fade_in,
                android.R.anim.fade_out
            )
            startActivity(intent, opts.toBundle())
        } catch (_: Throwable) {}
    }

    private fun triggerRecents() {
        injectKey(KeyEvent.KEYCODE_APP_SWITCH)
        val intent = Intent(this, HioneLauncherActivity::class.java).apply {
            putExtra("open_recents", true)
            flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED
        }
        try {
            val opts = android.app.ActivityOptions.makeCustomAnimation(
                this,
                android.R.anim.fade_in,
                android.R.anim.fade_out
            )
            startActivity(intent, opts.toBundle())
        } catch (_: Throwable) {}
    }

    private fun triggerBack() {
        injectKey(KeyEvent.KEYCODE_BACK)
        try {
            sendBroadcast(Intent("com.hione.systemui.action.TRIGGER_BACK"))
        } catch (_: Throwable) {}
        try {
            sendBroadcast(Intent("com.hione.player.action.TRIGGER_BACK"))
        } catch (_: Throwable) {}
    }

    override fun onDestroy() {
        super.onDestroy()
        gesturePillView?.let { view ->
            try { windowManager?.removeView(view) } catch (_: Throwable) {}
        }
        gesturePillView = null

        topShadeInterceptView?.let { view ->
            try { windowManager?.removeView(view) } catch (_: Throwable) {}
        }
        topShadeInterceptView = null

        leftEdgeView?.let { view ->
            try { windowManager?.removeView(view) } catch (_: Throwable) {}
        }
        leftEdgeView = null

        rightEdgeView?.let { view ->
            try { windowManager?.removeView(view) } catch (_: Throwable) {}
        }
        rightEdgeView = null
    }

    override fun onBind(intent: Intent?): IBinder? = null

    enum class GestureAction {
        HOME, RECENTS, QUICK_SWITCH
    }

    /**
     * Edge Back Touch and Animated Visual Indicator View.
     * Renders a glowing Cyber Back Chevron when swiping inward from the bezel.
     */
    class EdgeBackView(
        context: Context,
        private val isLeft: Boolean,
        private val onBackTriggered: () -> Unit
    ) : View(context) {

        private val density = resources.displayMetrics.density
        private var startX = 0f
        private var startY = 0f
        private var currentX = 0f
        private var currentY = 0f
        private var isTracking = false
        private var isTriggered = false

        private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.FILL
        }

        private val arrowPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE
            strokeWidth = 3.5f * density
            strokeCap = Paint.Cap.ROUND
            strokeJoin = Paint.Join.ROUND
        }

        private val heartPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.FILL
            color = Color.WHITE
            textAlign = Paint.Align.CENTER
            textSize = 12f * density
        }

        override fun onDraw(canvas: Canvas) {
            super.onDraw(canvas)
            if (!isTracking) return

            val dx = if (isLeft) (currentX - startX).coerceAtLeast(0f) else (startX - currentX).coerceAtLeast(0f)
            val maxDrag = 40f * density
            val progress = (dx / maxDrag).coerceIn(0f, 1f)
            val centerY = currentY.coerceIn(40f * density, height - 40f * density)

            val pillRadius = 22f * density
            val pillWidth = (18f + progress * 22f) * density
            
            // Kawaii Hione Teal & Sakura Pink Gradient
            val baseColor = if (isTriggered) Color.parseColor("#FF69B4") else Color.parseColor("#FFAB2E")
            paint.color = baseColor
            paint.alpha = (180 + (progress * 75)).toInt()

            val rect = if (isLeft) {
                RectF(-pillWidth * 0.25f, centerY - pillRadius, pillWidth, centerY + pillRadius)
            } else {
                RectF(width - pillWidth, centerY - pillRadius, width + pillWidth * 0.25f, centerY + pillRadius)
            }
            canvas.drawRoundRect(rect, pillRadius, pillRadius, paint)

            // Draw Kawaii Chevron Arrow
            arrowPaint.color = Color.WHITE
            arrowPaint.alpha = 255
            val arrowX = if (isLeft) pillWidth * 0.52f else width - pillWidth * 0.52f
            val arrowSize = 8f * density
            val path = Path()

            if (isLeft) {
                path.moveTo(arrowX + arrowSize * 0.45f, centerY - arrowSize * 0.8f)
                path.lineTo(arrowX - arrowSize * 0.45f, centerY)
                path.lineTo(arrowX + arrowSize * 0.45f, centerY + arrowSize * 0.8f)
            } else {
                path.moveTo(arrowX - arrowSize * 0.45f, centerY - arrowSize * 0.8f)
                path.lineTo(arrowX + arrowSize * 0.45f, centerY)
                path.lineTo(arrowX - arrowSize * 0.45f, centerY + arrowSize * 0.8f)
            }
            canvas.drawPath(path, arrowPaint)

            // Sweet Kawaii Heart Accent when swiped
            if (progress > 0.4f) {
                val heartX = if (isLeft) arrowX + 11f * density else arrowX - 11f * density
                heartPaint.alpha = ((progress - 0.4f) / 0.6f * 255).toInt()
                canvas.drawText("♥", heartX, centerY + 4f * density, heartPaint)
            }
        }

        override fun onTouchEvent(event: MotionEvent): Boolean {
            when (event.actionMasked) {
                MotionEvent.ACTION_DOWN -> {
                    startX = event.rawX
                    startY = event.rawY
                    currentX = event.rawX
                    currentY = event.rawY
                    isTracking = true
                    isTriggered = false
                    invalidate()
                    return true
                }
                MotionEvent.ACTION_MOVE -> {
                    if (!isTracking) return false
                    currentX = event.rawX
                    currentY = event.rawY
                    val dx = if (isLeft) (event.rawX - startX) else (startX - event.rawX)
                    val dy = Math.abs(event.rawY - startY)

                    val threshold = 12f * density
                    if (dx > threshold && dy < 2.0f * dx && !isTriggered) {
                        isTriggered = true
                        HioneTactileHaptics.playRatchetTick(context)
                        onBackTriggered()
                    }
                    invalidate()
                    return true
                }
                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
                    isTracking = false
                    isTriggered = false
                    invalidate()
                    return true
                }
            }
            return super.onTouchEvent(event)
        }
    }

    /**
     * Floating Navigation Pill Bar for Home / Recents / App Switch.
     */
    class GesturePillView(
        context: Context,
        private val onAction: (GestureAction) -> Unit
    ) : View(context) {

        private val pillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.FILL
        }

        private val glowPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE
            strokeWidth = 1.5f
            color = Color.parseColor("#4D00E5FF")
        }

        private var startY = 0f
        private var startX = 0f
        private var currentY = 0f
        private var currentX = 0f
        private var startTime = 0L
        private var isDragging = false
        private var isHoldArmed = false

        private val holdHandler = android.os.Handler(android.os.Looper.getMainLooper())
        private val holdRunnable = Runnable {
            if (isDragging && (currentY - startY) < -14f) {
                isHoldArmed = true
                HioneTactileHaptics.playRatchetTick(context)
                invalidate()
            }
        }

        private val density = resources.displayMetrics.density
        private val pillWidthPx = 76 * density
        private val pillHeightPx = 4.5f * density
        private val pillRadiusPx = 2.5f * density

        override fun onDraw(canvas: Canvas) {
            super.onDraw(canvas)
            val w = width.toFloat()
            val h = height.toFloat()

            val offsetY = if (isDragging) (currentY - startY).coerceAtMost(0f) * 0.4f else 0f
            val pillLeft = (w - pillWidthPx) / 2f
            val pillTop = h - pillHeightPx - (5 * density) + offsetY
            val pillRight = pillLeft + pillWidthPx
            val pillBottom = pillTop + pillHeightPx

            val rect = RectF(pillLeft, pillTop, pillRight, pillBottom)

            // Dynamic Gradient: Cyan to Neon Pink (or full pink when hold armed)
            val startColor = if (isHoldArmed) Color.parseColor("#FFFF2277") else Color.parseColor("#00E5FF")
            val endColor = Color.parseColor("#FF1177")

            val shader = LinearGradient(
                pillLeft, pillTop, pillRight, pillBottom,
                intArrayOf(startColor, endColor),
                null,
                Shader.TileMode.CLAMP
            )
            pillPaint.shader = shader

            // Subtle glow
            canvas.drawRoundRect(
                RectF(pillLeft - 1f, pillTop - 1f, pillRight + 1f, pillBottom + 1f),
                pillRadiusPx + 1f,
                pillRadiusPx + 1f,
                glowPaint
            )

            // Main pill body
            canvas.drawRoundRect(rect, pillRadiusPx, pillRadiusPx, pillPaint)
        }

        override fun onTouchEvent(event: MotionEvent): Boolean {
            when (event.actionMasked) {
                MotionEvent.ACTION_DOWN -> {
                    startX = event.rawX
                    startY = event.rawY
                    currentX = event.rawX
                    currentY = event.rawY
                    startTime = SystemClock.elapsedRealtime()
                    isDragging = true
                    isHoldArmed = false
                    holdHandler.removeCallbacks(holdRunnable)
                    holdHandler.postDelayed(holdRunnable, 260L)
                    invalidate()
                    return true
                }
                MotionEvent.ACTION_MOVE -> {
                    if (!isDragging) return false
                    currentX = event.rawX
                    currentY = event.rawY
                    val deltaY = currentY - startY
                    if (deltaY >= -14f) {
                        holdHandler.removeCallbacks(holdRunnable)
                        holdHandler.postDelayed(holdRunnable, 260L)
                    }
                    invalidate()
                    return true
                }
                MotionEvent.ACTION_CANCEL -> {
                    if (!isDragging) return false
                    isDragging = false
                    isHoldArmed = false
                    holdHandler.removeCallbacks(holdRunnable)
                    invalidate()
                    return true
                }
                MotionEvent.ACTION_UP -> {
                    if (!isDragging) return false
                    isDragging = false
                    holdHandler.removeCallbacks(holdRunnable)
                    val deltaY = currentY - startY
                    val deltaX = currentX - startX
                    val duration = SystemClock.elapsedRealtime() - startTime
                    invalidate()

                    if (deltaY < -10f * density) {
                        HioneTactileHaptics.playRatchetTick(context)
                        if (isHoldArmed || duration >= 260L) {
                            onAction(GestureAction.RECENTS)
                        } else {
                            onAction(GestureAction.HOME)
                        }
                    } else if (Math.abs(deltaX) > 24f * density && Math.abs(deltaY) < 16f * density) {
                        HioneTactileHaptics.playRatchetTick(context)
                        onAction(GestureAction.QUICK_SWITCH)
                    } else if (Math.abs(deltaY) < 10f * density && duration < 260L) {
                        HioneTactileHaptics.playRatchetTick(context)
                        onAction(GestureAction.HOME)
                    }
                    isHoldArmed = false
                    return true
                }
            }
            return super.onTouchEvent(event)
        }
    }
}
