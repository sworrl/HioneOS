<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mascot packs (Mascot.kt). Every HioneOS app declares the same signature permission, so it
         exists whichever app is installed first. Hione Update's pack provider requires it. -->
    <permission
        android:name="com.hione.permission.MASCOT_PACKS"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.hione.permission.MASCOT_PACKS" />
    <queries>
        <provider android:authorities="com.hione.update.mascot" />
    </queries>


    <!-- DAC filter, gain, DRE and high power tiles go through com.hione.sysbridge. See DacBridge. -->
    <uses-permission android:name="com.hione.permission.SYSTEM_BRIDGE" />
    <uses-permission android:name="android.permission.STATUS_BAR" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.SHUTDOWN" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.BROADCAST_CLOSE_SYSTEM_DIALOGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Grants our own notification listener access. Writing enabled_notification_listeners is
         ignored by NotificationManagerService on Android 14, so the shade had no notifications. -->
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS" tools:ignore="ProtectedPermissions" />
    <!-- Lets the top pull strip be an input spy window, so the stock status bar cannot take the
         pull away from it (see HioneNotificationShadeService.stripIsSpy). -->
    <!-- App names and icons for notifications from any app (Google Fi showed its package name). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.MONITOR_INPUT" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Navigation layer (quick switch + Hione Recents). All signature|privileged: granted by the
         platform signature, no priv-app whitelist needed. Hidden APIs reached via reflection. -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <uses-permission android:name="android.permission.START_TASKS_FROM_RECENTS" />
    <uses-permission android:name="android.permission.REMOVE_TASKS" />
    <uses-permission android:name="android.permission.READ_FRAME_BUFFER" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Media sessions for the shade media card / recents chip / Now-Playing HUD (signature-level; granted to this platform-signed app). -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <!-- Trust agent (trust/HioneTrustAgent). signature|privileged, granted here by the platform
         signature. This app is not a priv-app, so no privapp-permissions entry is involved. -->
    <uses-permission android:name="android.permission.PROVIDE_TRUST_AGENT" tools:ignore="ProtectedPermissions" />
    <!-- Power menu Lockdown: LockPatternUtils.requireStrongAuth and getStrongAuthForUser.
         Signature permission, granted by the platform signature. -->
    <uses-permission android:name="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="HioneOS SystemUI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.M500Hardware">

        <!-- Starts Mascot (the active mascot pack) at process start. -->
        <provider
            android:name="com.hione.systemui.MascotInit"
            android:authorities="${applicationId}.mascot-init"
            android:exported="false"
            android:initOrder="1000" />


        <activity
            android:name=".HioneSystemUIActivity"
            android:exported="true"
            android:label="HioneOS SystemUI"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Home-screen entries, one per mascot label set. Mascot.syncAliases enables the one the
             active pack names and disables the others. The activity itself keeps no LAUNCHER
             filter, so explicit launches by class name keep working whatever the pack. -->
        <activity-alias
            android:name=".HioneSystemUIActivityHione"
            android:targetActivity=".HioneSystemUIActivity"
            android:exported="true"
            android:enabled="true"
            android:label="HioneOS SystemUI"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".HioneSystemUIActivityHits"
            android:targetActivity=".HioneSystemUIActivity"
            android:exported="true"
            android:enabled="false"
            android:label="HioneOS SystemUI"
            android:icon="@mipmap/ic_launcher_hione"
            android:roundIcon="@mipmap/ic_launcher_hione_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".HioneSystemUIActivityPlain"
            android:targetActivity=".HioneSystemUIActivity"
            android:exported="true"
            android:enabled="false"
            android:label="System UI"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".HioneShadeActivity"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE"
            android:label="Quick Settings Shade"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.M500Hardware">
            <intent-filter>
                <action android:name="android.intent.action.QUICK_SETTINGS" />
                <action android:name="com.hione.systemui.action.OPEN_SHADE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- HioneOS power modal. Reached two ways:
             1. Framework long-press-power -> "assistant" path (no accessibility service needed):
                Settings.Global power_button_long_press=5 (LONG_PRESS_POWER_ASSISTANT) makes
                PhoneWindowManager call StatusBar.startAssist(), and stock SystemUI launches the
                component named in Settings.Secure `assistant` with ACTION_ASSIST — that is us.
                Both settings are seeded by the ROM rc (build_hioneos_super.sh).
             2. HioneNotificationShadeService (accessibility key filter / GlobalActions sniff)
                as a fallback. singleInstance + singleTop so a double trigger is a no-op.
             The permission keeps other apps out. Stock SystemUI starts it for path 1 and holds
             START_ANY_ACTIVITY, which passes the check. -->
        <activity
            android:name=".HionePowerMenuActivity"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE"
            android:label="Power menu"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.M500Hardware.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_MENU" />
                <action android:name="com.hione.systemui.action.POWER_MENU" />
                <action android:name="com.android.internal.intent.action.GLOBAL_ACTIONS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Hione Recents: Pixel-style overview opened by the home-pill swipe-up-and-hold. -->
        <activity
            android:name=".HioneRecentsActivity"
            android:exported="false"
            android:label="Recents"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware.Translucent" />

        <!-- Nothing binds this: system_server binds com.android.systemui's own SystemUIService. -->
        <service
            android:name="com.android.systemui.SystemUIService"
            android:exported="false" />

        <service
            android:name=".HioneNotificationShadeService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- HioneOS trust agent: after the first credential unlock since restart, keeps the device
             openable with a swipe until the next restart. Only the system can bind it. -->
        <service
            android:name=".trust.HioneTrustAgent"
            android:exported="true"
            android:label="HioneOS unlock until restart"
            android:permission="android.permission.BIND_TRUST_AGENT">
            <intent-filter>
                <action android:name="android.service.trust.TrustAgentService" />
            </intent-filter>
            <meta-data
                android:name="android.service.trust.trustagent"
                android:resource="@xml/hione_trust_agent" />
        </service>

        <service
            android:name=".HioneShadeTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Hione Quick Settings"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".HioneNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Per-app notification summary for the launcher's top bar tray. Platform-signed
             HioneOS apps only (STATUS_BAR is signature|privileged). -->
        <provider
            android:name=".HioneNotificationTrayProvider"
            android:authorities="com.hione.systemui.notifications"
            android:exported="true"
            android:readPermission="android.permission.STATUS_BAR"
            android:writePermission="android.permission.STATUS_BAR" />

        <!-- Reply box for a notification's reply action. The shade is an accessibility overlay,
             which sits above the keyboard, so typing happens in this small activity instead. -->
        <activity
            android:name=".HioneReplyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.hione.systemui.reply"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible"
            android:theme="@style/Theme.M500Hardware.Translucent" />

        <receiver
            android:name=".SystemUIBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
