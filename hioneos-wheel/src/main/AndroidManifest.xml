<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mascot packs (Mascot.kt). Every HioneOS app declares the same signature permission, so it
         exists whichever app is installed first. Hione Update's pack provider requires it. -->
    <permission
        android:name="com.hione.permission.MASCOT_PACKS"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.hione.permission.MASCOT_PACKS" />
    <queries>
        <provider android:authorities="com.hione.update.mascot" />
    </queries>


    <!-- Lists come from MediaStore, playback goes through Hione Music's Media3 session. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets "Exit" hand the HOME role back to com.hione.launcher. Granted to platform-signed
         builds only; without it Exit still clears our preferred-home entry. -->
    <uses-permission android:name="android.permission.MANAGE_ROLE_HOLDERS" />

    <queries>
        <package android:name="com.hione.player" />
        <package android:name="com.hione.launcher" />
        <!-- The FM tuner, driven through its media session (FmMediaBrowserService). -->
        <package android:name="com.caf.fmradio" />
        <intent>
            <action android:name="androidx.media3.session.MediaLibraryService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.HioneWheel">

        <!-- Starts Mascot (the active mascot pack) at process start. -->
        <provider
            android:name="com.hione.wheel.MascotInit"
            android:authorities="${applicationId}.mascot-init"
            android:exported="false"
            android:initOrder="1000" />


        <!--
          One activity does everything: era picker, skins, and the HOME role. singleTask so a
          HOME press while it is the home app comes back to the same instance (onNewIntent).
        -->
        <activity
            android:name=".WheelActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:resizeableActivity="false"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.HioneWheel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Deep entry from the launcher's secrets list: extra "era" (2001/2004/2005/2007),
                 extra "force" (boolean, debug) skips the unlock check. -->
            <intent-filter>
                <action android:name="com.hione.wheel.action.ENTER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
