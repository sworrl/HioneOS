<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HionePlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#121318</item>
        <item name="android:navigationBarColor">#121318</item>
        <item name="android:windowBackground">#121318</item>
    </style>

    <style name="Theme.HioneLauncher" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#0C0D10</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowAnimationStyle">@style/HioneKdeWindowAnim</item>
        <!-- Kill the Android 12+ system splash (app icon on a blob). The app draws its own
             cold-boot splash; the OS one just flashes an icon on every warm start. -->
        <item name="android:windowSplashScreenBackground">#0C0D10</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <!-- KDE-style window transitions: apps FLY AWAY when sent to home (swipe up / task
         to back), FALL APART (crumble + tumble + drop) when actually closed, and FLY IN
         when opened. Replaces the stock slide-off-to-the-right. -->
    <!--
        The main Hione Music window, edge to edge.

        The parent theme sets FLAG_FULLSCREEN, which contradicts MainActivity showing the status bar
        again: while the flag is set the framework lays the app out BELOW the bar, so Hione Music got
        720x1239 of a 720x1280 panel and the top 41px was dead space it was already painting nothing
        into. Dropping the flag lets the window cover the whole panel and the stock clock/battery bar
        bleed over the app's own background. Headers keep statusBarsPadding(), so no text collides
        with the glyphs. Only MainActivity: the alarm ring and the other full-bleed activities still
        want the fullscreen parent.
    -->
    <style name="Theme.HioneMusic.EdgeToEdge" parent="Theme.HioneLauncher">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="HioneKdeWindowAnim">
        <!-- open an app -->
        <item name="android:activityOpenEnterAnimation">@anim/kde_flyin_in</item>
        <item name="android:taskOpenEnterAnimation">@anim/kde_flyin_in</item>
        <item name="android:activityOpenExitAnimation">@anim/kde_reveal_in</item>
        <!-- CLOSE an app (back / finish / recents-close) -> fall apart -->
        <item name="android:activityCloseExitAnimation">@anim/kde_fallapart_out</item>
        <item name="android:taskCloseExitAnimation">@anim/kde_fallapart_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/kde_reveal_in</item>
        <item name="android:taskCloseEnterAnimation">@anim/kde_reveal_in</item>
        <!-- SWIPE UP to home / send to back -> fly away -->
        <item name="android:taskToBackExitAnimation">@anim/kde_flyaway_out</item>
        <item name="android:wallpaperIntraCloseExitAnimation">@anim/kde_flyaway_out</item>
        <item name="android:wallpaperIntraCloseEnterAnimation">@anim/kde_reveal_in</item>
        <item name="android:taskToBackEnterAnimation">@anim/kde_reveal_in</item>
        <item name="android:taskToFrontEnterAnimation">@anim/kde_flyin_in</item>
        <item name="android:windowExitAnimation">@anim/kde_fallapart_out</item>
        <item name="android:windowEnterAnimation">@anim/kde_flyin_in</item>
    </style>

</resources>
