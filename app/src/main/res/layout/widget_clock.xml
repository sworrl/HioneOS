<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Digital Clock Header with Cyberpunk Hione Accent -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03:39"
            android:textColor="#FFAB2E"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/widget_clock_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="PM"
            android:textColor="#FF6699"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="SATURDAY, AUG 15"
        android:textColor="#C0E0DC"
        android:textSize="11sp"
        android:letterSpacing="0.08" />

    <!-- Subtitle / Brand Badge -->
    <TextView
        android:id="@+id/widget_clock_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="初音ミク · M500 DAP"
        android:textColor="#668B87"
        android:textSize="9.5sp"
        android:letterSpacing="0.1" />
</LinearLayout>
