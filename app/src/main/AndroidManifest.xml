<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Mascot packs (Mascot.kt). Every HioneOS app declares the same signature permission, so it
         exists whichever app is installed first. Hione Update's pack provider requires it. -->
    <permission
        android:name="com.hione.permission.MASCOT_PACKS"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.hione.permission.MASCOT_PACKS" />
    <queries>
        <provider android:authorities="com.hione.update.mascot" />
    </queries>


    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Folder cover art (cover.jpg / folder.jpg beside the FLACs) is read through MediaStore.Images
         when raw file access to the SD card isn't available (scoped storage). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Platform-signed: lets the player self-grant its own "All files access" app-op at launch
         (HioneStorageAccess) instead of stranding SD-card art/scans behind a Settings screen. -->
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" tools:ignore="ProtectedPermissions" />
    <!-- Alarm/haptics feedback (AlarmRingService, Haptics). Without this, Vibrator.vibrate
         no-ops and lint flags it as a MissingPermission crash risk. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- BluetoothAdapter/BluetoothDevice access in Settings (bonded-device list, enable/
         disable, getName). BLUETOOTH_CONNECT is the API 31+ runtime permission; the legacy
         BLUETOOTH/BLUETOOTH_ADMIN cover pre-31. Without CONNECT, getBondedDevices/getName
         throw SecurityException on this API-34 device. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Real, raw filesystem access to EVERY storage volume (SD cards included), not just the
         primary one MediaStore/scoped-storage otherwise limits third-party apps to. Confirmed
         live (2026-08-17) that without this, java.io.File can't even list/stat SD-card paths from
         this app's process (SELinux denies it — see mediaStoreRowLikelyValid()'s doc comment in
         Model.kt), which was the root cause of both the library undercounting real tracks AND the
         scan's own directory walk being structurally blind to the SD card. Play Store restricts
         this permission to core file-manager-type apps; that policy doesn't apply here since this
         app is sideloaded directly, never distributed through the Store — same reasoning already
         used for USE_EXACT_ALARM. Unlike a normal runtime permission, Android forces this through
         a dedicated system Settings toggle (Special app access → All files access) that can't be
         silently auto-granted even for a sideloaded app — see requestAllFilesAccessIfNeeded() in
         MainActivity and the Settings banner in AlarmsCard's sibling (LibraryAccessCard). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Special "Modify system settings" access — special app access, same family as
         MANAGE_EXTERNAL_STORAGE above, requested via a Settings intent, never silently granted.
         Sole use: ScreenOffHelper briefly shrinks the SYSTEM screen-off timeout to make the AOD ->
         real-sleep idle stage happen close to on-demand, then restores the user's real value.
         There's no public Android API for a normal app to just turn the screen off directly
         (that's deliberate OS policy, not an oversight) — this is the standard, App-Store-legal
         mechanism real "quick screen off" utility apps use for the same effect. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- USB DAC mode is switched by com.hione.sysbridge (system UID); see UsbDacManager. -->
    <uses-permission android:name="com.hione.permission.SYSTEM_BRIDGE" />
    <!-- Per-output volume while playing to several outputs (volume/HioneOutputVolumes):
         AudioManager.get/setDeviceVolume. Signature permissions; this app is platform-signed. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- LibraryScanService: the media-library rescan needs to keep running reliably even with the
         screen off / app backgrounded (confirmed live this wasn't happening as a plain Thread) —
         "dataSync" is the correct foregroundServiceType for background file-indexing work. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- HioneRemoteGattService (remote/): BLE GATT peripheral so a phone's browser can drive playback.
         "connectedDevice" is the foregroundServiceType for a Bluetooth peripheral session; the
         BLUETOOTH_ADVERTISE/CONNECT runtime grants above satisfy its API-34 prerequisite. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Alarm Mode: exact, Doze-exempt wake-ups via AlarmManager.setAlarmClock. USE_EXACT_ALARM is
         auto-granted at install (no runtime prompt) for a sideloaded app like this one — Play
         Store's "alarm-clock apps only" restriction on that permission is a store-review policy,
         not an OS restriction, and this app is never distributed through the Store. SCHEDULE_EXACT_ALARM
         is declared alongside it as a fallback the app can still request via Settings if a future
         OS build ever treats USE_EXACT_ALARM differently for a non-Store install. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" tools:targetApi="33" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Without this, the alarm notification's setFullScreenIntent silently downgrades to a normal
         heads-up notification on API 29+ (enforced harder on 34+) — AlarmRingActivity would never
         auto-launch over a locked/asleep screen, defeating the whole "wakes the device" feature. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Vibration fallback for AlarmRingService — fires even if the library is empty/not yet
         scanned, so an alarm is never completely silent+motionless. -->
    <!-- Complete package query permission for launcher app drawer -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Camera-based ambient light sensor (M500 has no hardware ALS) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Platform-signed (re-keyed image) auto-grants this signature|privileged permission,
         unblocking the DAC/Fn/USB-DAC Settings.Global writes. Declaration only. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Pocket/Fn lock, root-free: toggle input devices + blank the screen (both signature perms). -->
    <uses-permission android:name="android.permission.DISABLE_INPUT_DEVICE" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.DEVICE_POWER" tools:ignore="ProtectedPermissions" />
    <!-- USB DAC mode exit: UsbManager.setCurrentFunctions/setScreenUnlockedFunctions (signature|privileged). -->
    <uses-permission android:name="android.permission.MANAGE_USB" tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Expand notification shade permission for launcher -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="Hione Music"
        android:description="@string/app_description"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.HioneLauncher">

        <!-- Starts Mascot (the active mascot pack) at process start. -->
        <provider
            android:name="com.hione.player.MascotInit"
            android:authorities="${applicationId}.mascot-init"
            android:exported="false"
            android:initOrder="1000" />


        <!-- Android Auto: declares HioneMusic as a media app (browse + play from the car head unit).
             The descriptor (@xml/automotive_app_desc) lists <uses name="media"/>; the browsable tree
             and playback are served by PlaybackService (a Media3 MediaLibraryService) via
             HioneLibraryCallback. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.HioneMusic.EdgeToEdge" />

        <!-- Home-screen entries, one per mascot label set. Mascot.syncAliases enables the one the
             active pack names and disables the others. The activity itself keeps no LAUNCHER
             filter, so explicit launches by class name keep working whatever the pack. -->
        <activity-alias
            android:name=".MainActivityHione"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="Hione Music"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityHits"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Hione Hits"
            android:icon="@mipmap/ic_launcher_hione"
            android:roundIcon="@mipmap/ic_launcher_hione_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityPlain"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Music"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>



        <activity
            android:name=".profiles.ListeningProfilesActivity"
            android:exported="false"
            android:label="Listening Profiles"
            android:theme="@style/Theme.HioneLauncher"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Hione Music's playback settings (profiles, direct route, car audio, USB DAC output).
             Not a DAC page and not a system settings target any more: the DAC page is the
             Hardware app's (com.hione.action.DAC_SETTINGS). Kept exported for old callers. -->
        <activity
            android:name=".HardwareSettingsActivity"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE"
            android:label="Playback settings"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:theme="@style/Theme.HioneLauncher"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />



        <activity
            android:name=".FnLockSettingsActivity"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE"
            android:label="Hione Fn Key &amp; Pocket Lock"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:theme="@style/Theme.HioneLauncher"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="com.hione.player.action.FN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HioneSettingsActivity"
            android:exported="true"
            android:label="Hione Settings"
            android:icon="@drawable/ic_settings_hione"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:theme="@style/Theme.HioneLauncher"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.PREFERENCE" />
            </intent-filter>
        </activity>


        <!-- FN_BUTTON_STATE_CHANGE comes from system_server (HiBy InputManagerService), which
             passes any permission check. The permission stops other apps faking the cover switch. -->
        <receiver
            android:name=".HioneFnLockReceiver"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE">
            <intent-filter android:priority="999">
                <action android:name="FN_BUTTON_STATE_CHANGE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".sentinel.HioneNotificationSentinelService"
            android:exported="true"
            android:label="Hione Notification Filter"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".radio.HioneFMRadioActivity"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE"
            android:label="Hione FM Radio"
            android:icon="@drawable/ic_fm_hione"
            android:launchMode="singleTask"
            android:theme="@style/Theme.HioneLauncher"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- No LAUNCHER entry: the real tuner (com.caf.fmradio) is the one "FM Radio" in the
                 app drawer. This old in-app radio stays reachable by explicit intent only. -->
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <!-- MediaLibraryService: serves the Media3 session AND the Android Auto browsable media
                 tree. Android Auto discovers a media app via the legacy
                 android.media.browse.MediaBrowserService action (Media3 provides the compat bridge);
                 the MediaLibraryService/MediaSessionService actions are how Media3's own
                 SessionToken resolution finds this service. All three kept so both paths work. -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Hardware/BT media-button routing when the app is NOT foreground or screen is OFF.
             Priority 1000 ensures immediate dispatch from framework PhoneWindowManager and AudioService.
             Matches HiBy vendor LineCtrl receiver behavior. -->
        <receiver
            android:name=".HioneMediaButtonReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <action android:name="hiby_media_button_action" />
                <action android:name="ACTION_MEDIA_BUTTON" />
                <action android:name="com.hione.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".UsbDacTileService"
            android:icon="@drawable/ic_hione_monitor_status"
            android:label="USB DAC"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".LibraryScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Whole-library tempo analysis (QM-DSP TempoTrackV2), only while charging. -->
        <service
            android:name=".bpm.HioneBpmScanJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Phone-as-Bluetooth-remote: BLE GATT server advertised ONLY while the Settings toggle
             is on (default off). Companion page: tools/remote-pwa (Web Bluetooth, no phone app). -->
        <service
            android:name=".remote.HioneRemoteGattService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".launcher.HioneLiveWallpaperService"
            android:label="Hione Live Wallpaper"
            android:icon="@drawable/ic_search_head_hione"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/hione_wallpaper_info" />
        </service>
        <receiver
            android:name=".HioneMusicWidget"
            android:exported="true"
            android:label="Hione Music Now Playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>

        <receiver
            android:name=".HioneTapeWidget"
            android:exported="true"
            android:label="Hione Music Tape Deck">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tape_info" />
        </receiver>

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- Cross-app preference bridge: the HioneOS launcher's quick-settings shade flips
             playback behavior (pause-on-unplug) live via this broadcast. -->
        <receiver
            android:name=".HionePrefsReceiver"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE">
            <intent-filter>
                <action android:name="com.hione.player.SET_PAUSE_ON_UNPLUG" />
                <action android:name="com.hione.player.action.TOGGLE_LIKE" />
                <action android:name="com.hione.player.action.SET_LIKE" />
                <action android:name="com.hione.player.action.PROFILE" />
                <action android:name="com.hione.player.action.PRESET_SELFTEST" />
                <action android:name="com.hione.player.action.FORCE_LIBRARY_SCAN" />
                <action android:name="com.hione.player.action.RESCAN_LIBRARY" />
                <action android:name="com.hione.player.action.SET_INGEST_ENABLED" />
                <action android:name="com.hione.player.action.PLAY_RANDOM" />
            </intent-filter>
        </receiver>

        <!-- The same receiver for adb (`adb shell am broadcast -a ... -p com.hione.player`): the
             shell holds DUMP, other apps cannot get it. Dev and test actions only. -->
        <receiver
            android:name=".HionePrefsShellReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.hione.player.action.PROFILE" />
                <action android:name="com.hione.player.action.PRESET_SELFTEST" />
                <action android:name="com.hione.player.action.FORCE_LIBRARY_SCAN" />
                <action android:name="com.hione.player.action.RESCAN_LIBRARY" />
                <!-- hionemeasure (see MeasureShell in HionePrefsReceiver.kt) -->
                <action android:name="com.hione.player.action.PLAY_FILE" />
                <action android:name="com.hione.player.action.MEASURE_STOP" />
                <action android:name="com.hione.player.action.MEASURE_STATUS" />
                <action android:name="com.hione.player.action.DAC_SET" />
            </intent-filter>
        </receiver>

        <!-- Songs hearted in the FM app (com.caf.fmradio FmLikes) land in the Wanted list
             (wanted/WantedStore). Guarded by the signature-level SYSTEM_BRIDGE permission so only
             platform-signed senders reach it. -->
        <receiver
            android:name=".wanted.FmTrackLikedReceiver"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE">
            <intent-filter>
                <action android:name="com.hione.player.action.FM_TRACK_LIKED" />
            </intent-filter>
        </receiver>

        <!-- Settings → Listening stats (per-listen stats DB: totals, top-10s, hours, CSV export). -->
        <activity
            android:name=".stats.ListeningStatsActivity"
            android:exported="false"
            android:label="Listening Stats"
            android:theme="@style/Theme.HioneLauncher"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Listening stats → Hione Rewind (Wrapped-style story cards over the same listen DB;
             share PNGs go through the statsexport FileProvider below). -->
        <activity
            android:name=".stats.HioneRewindActivity"
            android:exported="false"
            android:label="Hione Rewind"
            android:theme="@style/Theme.HioneLauncher"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Listening-stats CSV export (StatsRepository.exportCsv): share-sheet grant for files
             under Android/data/com.hione.player/files/stats/. Separate authority from the HUD art
             provider so its cache-path exposure stays untouched. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.hione.player.statsexport"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/stats_export_paths" />
        </provider>

        <!-- Now-playing HUD art for HioneOS SystemUI (HioneTrackHud): read-granted per broadcast. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.hione.player.hudart"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/hud_art_paths" />
        </provider>

        <!-- Graceful-swap update handling (UpdateHandler.kt): the system delivers this to the
             app's own package right after a replacement APK finishes installing — guaranteed even
             for a freshly-updated "stopped" app, no special permission needed. Lets us auto-relaunch
             straight back into the same queue/position if playback was live when the update
             started, instead of leaving the user to notice the app just silently vanished. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AlarmBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Clock-time alarms are armed as absolute instants: a zone/clock change moves them, so re-arm. -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <!-- Belt-and-braces after an app update (idempotent). -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".AlarmRingActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.HionePlayer" />

        <receiver
            android:name=".HioneClockWidget"
            android:exported="true"
            android:label="Hione Music Clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <!-- Quick Settings Tile: Pocket Lock -->

        <service
            android:name=".PocketLockTileService"
            android:label="Pocket Lock"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Fullscreen Hione Cyber HUD Modal for Hardware Fn Switch events -->
        <activity
            android:name=".FnLockHudActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.HionePlayer" />

        <!-- Skeuomorphic booklet / physical-media art viewer (booklet/). The ONLY screen allowed to
             rotate: booklet scans are usually wide, so it follows the sensor while the rest of the
             app stays portrait. configChanges keeps the open fold/zoom state across rotation. -->
        <activity
            android:name=".booklet.BookletViewerActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.HioneLauncher" />

    
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1"/>
        <service
            android:name=".car.HioneCarAppService"
