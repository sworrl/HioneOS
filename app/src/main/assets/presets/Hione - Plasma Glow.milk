per_frame_10=ob_g = 0.902 - 0.090*treb_att;
per_frame_11=ob_b = 0.871 - 0.451*treb_att;
per_frame_12=ib_r = 1.000;
per_frame_13=ib_g = 0.373 + 0.439*mid_att;
per_frame_14=ib_b = 0.635 - 0.215*mid_att;
per_pixel_1=dx = (0.010+0.010*bass_att)*sin(y*12.0 + time*1.2) + 0.008*cos(rad*9.0 - time);
per_pixel_2=dy = (0.010+0.010*bass_att)*cos(x*12.0 + time*1.2) + 0.008*sin(rad*9.0 + time);
per_pixel_3=warp = warp + 0.04*sin(rad*7.0 + time) + 0.05*treb_att*cos(rad*5.0 - time);
