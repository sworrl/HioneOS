per_frame_1=zoom = 1.0 + 0.02*sin(time*0.6) + 0.12*bass_att;
per_frame_2=rot = 0.02*sin(time*0.25) + 0.05*mid_att;
per_frame_3=warp = 0.06 + 0.07*mid_att + 0.04*treb_att;
per_frame_4=q1 = 0.5 + 0.5*sin(time*0.5) + 0.25*bass_att;
per_frame_5=wave_r = 0.224 + 0.776*q1;
per_frame_6=wave_g = 0.773 - 0.400*q1;
per_frame_7=wave_b = 0.733 - 0.098*q1;
per_frame_8=wave_a = 0.6 + 0.4*vol;
