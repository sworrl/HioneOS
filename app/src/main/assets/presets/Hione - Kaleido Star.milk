per_frame_1=zoom = 1.0 + 0.02*sin(time*0.7) + 0.10*bass_att;
per_frame_2=rot = 0.05 + 0.03*sin(time*0.4) + 0.04*mid_att;
per_frame_3=warp = 0.04 + 0.06*treb_att + 0.02*sin(time*0.5);
per_frame_4=q1 = 0.5 + 0.5*sin(time*0.6) + 0.3*bass_att;
per_frame_5=wave_r = 0.224 + 0.776*q1;
per_frame_6=wave_g = 0.773 - 0.400*q1;
