per_frame_1=q1 = bass_att; q2 = mid_att; q3 = treb_att; q4 = 0.5+0.5*sin(time*0.190);
per_frame_2=q6 = sin(time*0.190)*3.1416;
per_frame_3=zoom = 0.994 + 0.024*sin(time*0.61)*q1 + 0.010*q3;
per_frame_4=rot = 0.02*sin(time*0.15) + 0.04*q3*sin(time*0.37);
per_frame_5=warp = 1.0 + 2.6*q2 + 1.1*q1*sin(time*0.43) + 0.5*sin(time*0.91);
per_frame_6=fWarpScale = 2.1;
per_frame_7=decay = 0.976;
per_frame_8=wave_r = 0.22 + 0.28*q4 + 0.30*q1; wave_g = 0.77 + 0.13*q4 - 0.15*q3; wave_b = 0.73 - 0.05*q4 - 0.28*q1;
