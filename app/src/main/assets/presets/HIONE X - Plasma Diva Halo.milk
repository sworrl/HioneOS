per_pixel_1=pl = sin(x*7+time*1.3) * cos(y*7*0.8-time*1.1);
per_pixel_2=pl2 = sin((x+y)*7*0.6 + q6);
per_pixel_3=warp = warp + 1.6*pl*pl2*q2 + 0.6*pl*q3;
per_pixel_4=dx = dx + 0.008*pl2*sin(time+y*9);
per_pixel_5=dy = dy + 0.008*pl*cos(time+x*9);
per_pixel_6=zoom = zoom + 0.03*pl*pl2*(0.3+q1);
