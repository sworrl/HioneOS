per_frame_1=vol = (bass + mid + treb)*0.333;
per_frame_2=zoom = 1.0 + 0.16*bass_att + 0.05*sin(time*0.9 + vol*2.0);
per_frame_3=rot = 0.02*sin(time*0.5) + 0.05*mid_att*sin(time*1.3);
per_frame_4=wave_r = 0.5 + 0.5*sin(time*2.0 + bass*3.0);
per_frame_5=wave_g = 0.5 + 0.4*sin(time*2.0 + 2.0 + mid*2.0);
per_frame_6=wave_b = 0.6 + 0.4*sin(time*2.0 + 4.0 + treb*2.0);
per_frame_7=decay = 0.94 + 0.05*bass_att;
per_frame_8=warp = 0.03 + 0.08*treb_att + 0.02*sin(time*0.6);
per_frame_9=wave_a = 0.7 + 0.3*vol;
per_frame_10=wave_mystery = 0.3*sin(time*0.7) + 0.2*mid_att;
per_frame_11=ob_r = 0.224 + 0.776*mid_att;
per_frame_12=ob_g = 0.773 - 0.400*mid_att;
per_frame_13=ob_b = 0.733 - 0.098*mid_att;
