per_frame_1=q1 = bass_att; q2 = mid_att; q3 = treb_att;
per_frame_2=q6 = sin(time*0.150)*3.1416;
per_frame_3=zoom = 0.998 + 0.012*sin(time*0.61)*q1;
per_frame_4=rot = 0.015*sin(time*0.31)*q1;
per_frame_5=warp = 1.1 + 2.2*q2 + 0.7*sin(time*0.43);
per_frame_6=fWarpScale = 1.9 + 0.5*q2;
per_frame_7=decay = 0.972 + 0.006*sin(time*0.5)*q1;
per_frame_8=q7 = min(1,q3); wave_r = 0.224 + 0.776*q7; wave_g = 0.773 - 0.400*q7; wave_b = 0.733 - 0.098*q7;
per_frame_9=bDarkenCenter = 0;
per_frame_10=mv_a = 0.15 + 0.35*q1; nMotionVectorsX = 24; nMotionVectorsY = 18;
per_frame_11=q8 = min(1,q1); mv_r = 0.224 + 0.776*q8; mv_g = 0.773 + 0.039*q8; mv_b = 0.733 - 0.313*q8;
per_pixel_1=pl = sin(x*9+time*1.3) * cos(y*9*0.8-time*1.1);
per_pixel_2=pl2 = sin((x+y)*9*0.6 + q6);
per_pixel_3=warp = warp + 2.0*pl*pl2*q2;
per_pixel_4=dx = dx + 0.008*pl2*sin(time+y*9)*(0.5+0.5*q1);
per_pixel_5=dy = dy + 0.008*pl*cos(time+x*9)*(0.5+0.5*q1);
per_pixel_6=zoom = zoom + 0.03*pl*pl2*(0.3+q1);
