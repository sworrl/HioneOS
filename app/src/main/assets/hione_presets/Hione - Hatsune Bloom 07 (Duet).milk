per_frame_1=mk1r = 0.220; mk1g = 0.770; mk1b = 0.730;
per_frame_2=mk2r = 1.000; mk2g = 0.370; mk2b = 0.640;
per_frame_3=mix = 0.5 + 0.5*sin(time*0.37) * 0.6 + bass_att*0.25;
per_frame_4=mix = min(1, max(0, mix));
per_frame_5=wave_r = mk1r + (mk2r - mk1r)*mix;
per_frame_6=wave_g = mk1g + (mk2g - mk1g)*mix;
per_frame_7=wave_b = mk1b + (mk2b - mk1b)*mix;
per_frame_8=q1 = 0.3 + bass_att*0.7;
per_frame_9=rot = 0.0060;
per_frame_10=decay = 0.97;
per_frame_11=wave_a = 0.4 + 0.6*bass;
per_pixel_1=rad = rad + 0.03*sin(ang*5 + time*1.1)*q1;
per_pixel_2=zoom = 1 + 0.015*q1;
