<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AudioRecord(MediaRecorder.AudioSource.RADIO_TUNER=1998) needs this; it's a
         privileged permission only granted to platform-signed system apps — which is
         why this ships in /system_ext/app and is signed with the platform key. -->
    <!--
      Required by the VENDOR jar, not by anything we wrote.

      qcom.fmradio.FmReceiver.enable(FmConfig, Context) calls WifiManager.getWifiState() as part
      of its FM/WLAN coexistence check, and WifiServiceImpl.enforceAccessPermission throws
      SecurityException without this. Observed on-device 2026-10-09 once the tuner was finally
      reachable: the JNI loaded, openV4L2Radio returned 82, soc came back as cherokee and the
      receiver reached FMRxOn, and then enable() threw before returning, so the engine reported
      "FM power-on FAILED" on hardware that had in fact powered on.

      ACCESS_WIFI_STATE is a normal (install-time) permission, so declaring it is the whole fix.

      NOT copied wholesale from stock FM2, which declares 29 permissions including MANAGE_USERS,
      INTERACT_ACROSS_USERS_FULL, STATUS_BAR and WRITE_SECURE_SETTINGS. Disassembling
      qcom.fmradio.jar shows only three permission-sensitive framework calls in the whole
      library. This one. BluetoothAdapter.getDefaultAdapter(), also inside enable(), but the
      adapter is assigned to a local and nothing is ever invoked on it, so no BLUETOOTH
      permission is needed. And TelephonyManager.listen(LISTEN_CALL_STATE), which lives in
      registerDataConnectionStateListener(), a method this app never calls, so READ_PHONE_STATE
      is not needed either. The rest of stock's list is for stock's own UI.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Song ID (fingerprint to the recognition service), its cover art, and the terrain
         profile behind every line-of-sight verdict all go over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network goes through com.hione.sysbridge; see FmNet. -->
    <uses-permission android:name="com.hione.permission.SYSTEM_BRIDGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Hardware transport keys (FmMediaKeys): a haptic tick per press, and the system media
         key listener that hands the keys to the radio while it is on. SET_MEDIA_KEY_LISTENER
         is signature-level, granted to this platform-signed app. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SET_MEDIA_KEY_LISTENER"
        tools:ignore="ProtectedPermissions" />
    <!-- Now-playing keys the widgets, AOD and lockscreen read (FmNowPlaying). Platform-signed. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      The tuner keeps running when the activity goes away (HioneFmService). On Android 14 a
      foreground service that holds audio must declare the media-playback type here as well as
      in the service element, and must hold the matching typed permission; the untyped
      FOREGROUND_SERVICE permission on its own is no longer enough.
      POST_NOTIFICATIONS is what the ongoing notification needs; a platform-signed system app is
      granted it without a prompt, and without the notification the service cannot stay up.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HioneFM">

        <!-- The stock FM driver JNI (qcom.fmradio / FmReceiverJNI) lives in this shared
             library; declare it so the classloader can reach /system/framework/qcom.fmradio.jar. -->
        <uses-library android:name="qcom.fmradio" android:required="false" />

        <activity
            android:name="com.caf.fmradio.HioneFMRadioActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only this app and its own notification actions talk to it. -->
        <service
            android:name="com.caf.fmradio.HioneFmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          Android Auto. The descriptor lists <uses name="media"/>, and Auto finds the browsable
          station list through the MediaBrowserService action on FmMediaBrowserService.
          Exported because Auto binds to it from its own process. It only lists stations and
          hands over the session token. Commands go through FmMediaSession to the same engine
          the tuner screen uses.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name="com.caf.fmradio.FmMediaBrowserService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
