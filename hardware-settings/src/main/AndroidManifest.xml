<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mascot packs (Mascot.kt). Every HioneOS app declares the same signature permission, so it
         exists whichever app is installed first. Hione Update's pack provider requires it. -->
    <permission
        android:name="com.hione.permission.MASCOT_PACKS"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.hione.permission.MASCOT_PACKS" />
    <queries>
        <provider android:authorities="com.hione.update.mascot" />
    </queries>


    <!-- USB DAC mode is switched by com.hione.sysbridge (system UID); see UsbDacManager. -->
    <uses-permission android:name="com.hione.permission.SYSTEM_BRIDGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DAC graph: "Measure with the mic" records a sine sweep with the built-in mic (asked at use). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Position, for HioneLocationFusion. ACCESS_FINE_LOCATION is Android's gate on reading Wi-Fi
      scan results as much as it is on GNSS, so Wi-Fi positioning needs it too. The passive
      provider is used for GNSS, so holding this does not mean the GNSS engine is running: it
      means we are told about fixes other apps already paid for.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      And this one, or none of the above does anything here. From Android 10 a process that is
      not in the foreground gets an EMPTY scan-result list and a withheld BSSID rather than an
      error, whatever else it holds. This is an always-alive background daemon by design, so
      without this it would read zero access points while seven were in range - which is what
      it did, silently, and which is indistinguishable from a device with no Wi-Fi.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Camera used ONLY as a substitute ambient-light sensor: one frame is
         captured on screen-on to read exposure parameters, then released.
         The M500 has no ALS. No image is stored or transmitted. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Fn pocket lock (FnLockDaemon): root-free input-device disable + screen blank -->
    <uses-permission android:name="android.permission.DISABLE_INPUT_DEVICE" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <!-- Blackjack Monitor (BlackjackMonitor.kt), read-only. READ_LOGS: the kernel log carries the
         driver's power events and one line per register write. DUMP: AudioFlinger's output
         threads, for the rate Android sends. MODIFY_AUDIO_ROUTING: unanonymized playback
         configs, the fallback for that rate. All three are granted to the platform signature. -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.M500Hardware">

        <!-- Starts Mascot (the active mascot pack) at process start. -->
        <provider
            android:name="com.m500.hardware.MascotInit"
            android:authorities="${applicationId}.mascot-init"
            android:exported="false"
            android:initOrder="1000" />


        <!-- Main M500 Hardware & DAC Settings (Integrated into System Settings) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
            <!-- The one DAC settings page on HioneOS. Hione Music, HioneSettings, the launcher and
                 the SystemUI DAC tiles (long-press) all open this. -->
            <intent-filter>
                <action android:name="com.hione.action.DAC_SETTINGS" />
                <action android:name="com.m500.hardware.action.DAC_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.settings.SOUND_SETTINGS" />
                <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.android.settings.category.ia.sound" />
                <category android:name="com.android.settings.category.ia.homepage" />
                <category android:name="com.android.settings.category.ia.system" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/hardware_settings_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/hardware_settings_summary" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-100" />
        </activity>

        <!-- Blackjack Monitor: which DAC driver runs and what it is doing. Read-only. Opened from
             the DAC page's driver card and from HioneSettings > About. -->
        <activity
            android:name=".BlackjackMonitorActivity"
            android:exported="true"
            android:label="Blackjack Monitor"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware">
            <intent-filter>
                <action android:name="com.hione.action.BLACKJACK_MONITOR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Bespoke Verbose USB DAC Mode Activity -->
        <activity
            android:name=".UsbDacActivity"
            android:exported="false"
            android:label="M500 USB DAC"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="com.m500.hardware.action.USB_DAC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <!-- Fullscreen Cyber Pocket Lock HUD Overlay -->
        <activity
            android:name=".PocketHudActivity"
            android:exported="false"
            android:label="Pocket Lock HUD"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware.Translucent">
            <intent-filter>
                <action android:name="com.m500.hardware.action.SHOW_POCKET_HUD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Settings Tiles -->
        <service
            android:name=".UsbDacTileService"
            android:label="USB DAC"
            android:icon="@android:drawable/ic_dialog_info"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".PocketLockTileService"
            android:label="Pocket Lock"
            android:icon="@android:drawable/ic_lock_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <!-- Started by sysbridge BootSeeds (system uid) and the launcher, both HioneOS-signed.
             Foreground so A14 does not reap the screen-on receiver it hosts. -->
        <service
            android:name=".AmbientBrightnessService"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE"
            android:foregroundServiceType="camera|specialUse"
            android:description="@string/app_name">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Camera-derived ambient light auto-brightness (device has no ALS)" />
        </service>

        <service
            android:name=".PocketLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="System hardware key and touch lock barrier" />
        </service>


        <!-- FN_BUTTON_STATE_CHANGE comes from system_server, which passes any permission check.
             The permission stops other apps faking the cover switch or pocket lock. -->
        <receiver
            android:name=".PocketLockReceiver"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE">
            <intent-filter>
                <action android:name="FN_BUTTON_STATE_CHANGE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
