<?xml version="1.0" encoding="utf-8"?>
<!-- Kawaii tap-tempo orb for the BPM tapper widgets: round Hione-pink heart-orb with a soft
     radial core and a light-teal ring, echoing the in-modal KawaiiWaifuTapTempoOrb. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="24dp"
        android:startColor="#FFFF7FC0"
        android:centerColor="#FFFF4FA3"
        android:endColor="#FFB1246E" />
    <stroke android:width="1.5dp" android:color="#AAFFE0B0" />
</shape>
