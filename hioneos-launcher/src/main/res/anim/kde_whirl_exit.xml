<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <rotate android:fromDegrees="0" android:toDegrees="10" android:pivotX="50%p" android:pivotY="50%p"
        android:duration="200" android:interpolator="@android:interpolator/accelerate_cubic"/>
    <scale android:fromXScale="1.0" android:toXScale="0.75" android:fromYScale="1.0" android:toYScale="0.75"
        android:pivotX="50%p" android:pivotY="50%p" android:duration="200"/>
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="200"/>
</set>
