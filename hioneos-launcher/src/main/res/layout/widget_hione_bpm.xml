<?xml version="1.0" encoding="utf-8"?>
<!-- Hione Now-Playing / BPM badge widget (display only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bpm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/hione_badge_widget_bg"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_bpm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HIONE MUSIC"
        android:textColor="#FFE0B0"
        android:textSize="8sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_bpm_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♪ 120 BPM"
        android:textColor="#FF4FA3"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
