<?xml version="1.0" encoding="utf-8"?>
<!-- Hione BPM combo widget: live now-playing tempo on top, tap-tempo orb + tapped readout below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_combo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/hione_badge_widget_bg"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_combo_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HIONE MUSIC"
        android:textColor="#FFE0B0"
        android:textSize="8sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_combo_live"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♪ 120 BPM"
        android:textColor="#FF4FA3"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/widget_combo_tap_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/hione_tap_orb_bg"
            android:text="♥"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_combo_tapped"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAP — BPM"
                android:textColor="#FFAB2E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_combo_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAP IN"
                android:textColor="#FFE0B0"
                android:textSize="8sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
