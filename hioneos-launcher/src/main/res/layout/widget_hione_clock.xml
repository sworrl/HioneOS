<?xml version="1.0" encoding="utf-8"?>
<!-- Hione Clock badge widget. TextClock ticks by itself inside RemoteViews — no update service. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/hione_badge_widget_bg"
    android:padding="6dp">

    <TextClock
        android:id="@+id/widget_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="#FFAB2E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextClock
        android:id="@+id/widget_clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE, MMM d"
        android:format24Hour="EEE, MMM d"
        android:textColor="#FFE0B0"
        android:textSize="8sp"
        android:maxLines="1" />
</LinearLayout>
