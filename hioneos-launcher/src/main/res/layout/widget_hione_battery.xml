<?xml version="1.0" encoding="utf-8"?>
<!-- Hione Battery badge widget. Compact by default (badge sized); scales up cleanly when the user
     resizes to standard cells (gravity centered, wrap content on the inner row). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_battery_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/hione_badge_widget_bg"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_battery_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"
        android:src="@android:drawable/ic_lock_idle_charging"
        android:tint="#FFAB2E"
        android:contentDescription="Battery" />

    <TextView
        android:id="@+id/widget_battery_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100%"
        android:textColor="#FFE0B0"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
