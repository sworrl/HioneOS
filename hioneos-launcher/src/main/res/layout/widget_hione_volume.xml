<?xml version="1.0" encoding="utf-8"?>
<!-- Hione Volume badge widget: speaker glyph + STREAM_MUSIC percent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_volume_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/hione_badge_widget_bg"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_volume_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="3dp"
        android:text="🔊"
        android:textSize="11sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_volume_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VOL 50%"
        android:textColor="#FFAB2E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
