<?xml version="1.0" encoding="utf-8"?>
<!-- Hione Thermal badge widget: CPU temp headline + battery temp subline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_thermal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/hione_badge_widget_bg"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_thermal_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="3dp"
        android:text="🌡"
        android:textSize="12sp"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_thermal_cpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="42°C"
            android:textColor="#FFAB2E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_thermal_bat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BAT 38°C"
            android:textColor="#FFE0B0"
            android:textSize="7sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
