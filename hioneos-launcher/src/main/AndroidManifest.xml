<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mascot packs (Mascot.kt). Every HioneOS app declares the same signature permission, so it
         exists whichever app is installed first. Hione Update's pack provider requires it. -->
    <permission
        android:name="com.hione.permission.MASCOT_PACKS"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.hione.permission.MASCOT_PACKS" />
    <!-- Switches the home-screen label aliases of the other HioneOS apps when the pack changes.
         Signature|privileged, held because this app is platform-signed. -->
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" tools:ignore="ProtectedPermissions" />
    <queries>
        <provider android:authorities="com.hione.update.mascot" />
    </queries>


    <!-- Keeps the system zone following the device when it travels. NITZ cannot do this
         on a data-only SIM whose PS registration is denied, so the zone comes from the
         weather fix instead. See HioneTimeZoneSync. Signature|privileged, held because
         the launcher is platform-signed. -->
    <!-- USB DAC mode is switched by com.hione.sysbridge (system UID). -->
    <uses-permission android:name="com.hione.permission.SYSTEM_BRIDGE" />
    <uses-permission android:name="android.permission.SET_TIME_ZONE" />

    <!-- Startup tuning does what a root shell used to: set an app op and grant a runtime
         permission. Both are signature|privileged and are held because the launcher is
         platform-signed. Without these declared the reflective calls in HioneSystemTuning throw
         SecurityException, which is exactly what they did before they were added. -->
    <!-- WIFI_MODE_FULL_HIGH_PERF wifi locks need this; see HioneSystemTuning.holdWifiLock. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
    <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Session-agnostic lockscreen now-playing: read/control ANY app's MediaSession (Spotify etc).
         signature-protected; granted via the Falcon platform key. -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" tools:ignore="ProtectedPermissions" />
    <!-- Live BPM/beat detection from the actual output mix (Visualizer on session 0) so the BPM
         counter "sees ALSA" for ANY source (Spotify etc), not just Hione file analysis. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Cellular signal strength / SIM state for the status-bar signal meter. Without this the
         telephony reads return defaults and the signal pod can't reflect the real radio. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Haptic feedback (BPM tap-tempo orb + UI ticks). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Severe/extreme NWS weather alert notifications (weather/HioneNwsAlerts). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ActivityManager.moveTaskToFront (bring launcher/app forward). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- OS lockscreen: arm the SCREEN_ON/SCREEN_OFF state machine at boot via HioneLockscreenBootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <!-- Native WireGuard VPN client (com.hione.launcher.vpn / GoBackend). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="HioneOS Launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.M500Hardware"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Starts Mascot (the active mascot pack) at process start. -->
        <provider
            android:name="com.hione.launcher.MascotInit"
            android:authorities="${applicationId}.mascot-init"
            android:exported="false"
            android:initOrder="1000" />


        <activity
            android:name=".HioneLauncherActivity"
            android:exported="true"
            android:label="HioneOS Launcher"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- USB audio host (DAC-out) watcher: was started by the launcher but never declared -> "Unable to start service ... not found" on every launch. -->

        <service android:name=".usb.HioneUsbAudioHostService" android:exported="false" />

        <service
            android:name=".HioneLiveWallpaperService"
            android:exported="true"
            android:label="Hione Live Wallpaper"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper" />
        </service>

        <activity
            android:name=".crash.HioneCrashActivity"
            android:exported="false"
            android:label="HioneOS Recovery"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <activity
            android:name=".arco.HioneArcoSettingsActivity"
            android:exported="false"
            android:label="arcobocconotto RGB Fleet"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware"
            android:windowSoftInputMode="adjustResize" />

        <!-- The BPM game as its own activity, so Hione Music, the home screen, the app drawer and
             the BPM widgets can all open it and closing it returns to whoever opened it. Started
             from an Activity it joins the caller's task (no NEW_TASK); from a widget it gets its
             own excluded-from-recents task. The LAUNCHER category is its app drawer entry.
             Contract: see bpm/HioneBpmGameActivity.kt. -->
        <activity
            android:name=".bpm.HioneBpmGameActivity"
            android:exported="true"
            android:label="BPM Game"
            android:icon="@drawable/ic_bpm_game"
            android:taskAffinity="com.hione.launcher.bpmgame"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="com.hione.action.OPEN_BPM_GAME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OS-level Oki Hione Custom Lockscreen (ported out of the music app). Shows over the
             keyguard, fullscreen/no-title, excluded from recents, single instance. -->
        <activity
            android:name=".lockscreen.HioneLockscreenActivity"
            android:exported="true"
            android:permission="com.hione.permission.SYSTEM_BRIDGE"
            android:label="Hione Lockscreen"
            android:theme="@style/Theme.HioneLockscreen"
            android:showWhenLocked="true"
            android:inheritShowWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Always-On Display face (clock / weather / now-playing). Engaged by
             HioneLockscreenManager per the AOD prefs; taps hand off to the lockscreen. -->
        <activity
            android:name=".lockscreen.HioneAodActivity"
            android:exported="false"
            android:label="Hione AOD"
            android:theme="@style/Theme.HioneLockscreen"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- AOD options (mode + face content). -->
        <activity
            android:name=".lockscreen.HioneAodSettingsActivity"
            android:exported="true"
            android:label="AOD Settings"
            android:theme="@style/Theme.HioneLockscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bench/dev WiFi provisioning over adb (see HioneDevWifiReceiver). Gated behind
             WRITE_SECURE_SETTINGS: only shell/system can send it. -->


        <!-- Index what the ingress relay just pushed. The relay fires this as its last step,
             because adb push writes straight to the card and MediaStore never hears about it.
             See HioneIngestScanReceiver and tools/ingress-relay/relay.py. The sender is adb
             (m500d), and the shell holds DUMP. Other apps cannot get it. -->
        <receiver
            android:name=".ingest.HioneIngestScanReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.hione.launcher.action.INGEST_SCAN" />
            </intent-filter>
        </receiver>

        <!-- Force a fresh position without opening the weather screen. See HioneLocationReceiver.
             adb only, so DUMP like the ingest scan. -->
        <receiver
            android:name=".weather.HioneLocationReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.hione.launcher.action.REFRESH_LOCATION" />
            </intent-filter>
        </receiver>

        <!-- Import the Windy API keys from adb into the encrypted key store. See HioneWindyKeyReceiver.
             DUMP like the two above: the shell holds it, other apps cannot get it. -->
        <receiver
            android:name=".weather.HioneWindyKeyReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.hione.launcher.action.WINDY_KEYS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".network.HioneDevWifiReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.hione.launcher.WIFI_JOIN" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             Hione status-badge App Widgets — the in-bar badges as individual, placeable,
             resizable system widgets. Badge-sized by default, resizable to standard cells.
             RemoteViews (matching the app's Clock/Music/Tape widgets).
             ============================================================ -->
        <receiver
            android:name=".widget.HioneBatteryWidget"
            android:exported="true"
            android:label="Hione Battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hione_battery_info" />
        </receiver>
        <receiver
            android:name=".widget.HioneLauncherClockWidget"
            android:exported="true"
            android:label="Hione Clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hione_clock_info" />
        </receiver>
        <receiver
            android:name=".widget.HioneSignalWidget"
            android:exported="true"
            android:label="Hione Signal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hione_signal_info" />
        </receiver>
        <receiver
            android:name=".widget.HioneBpmWidget"
            android:exported="true"
            android:label="Hione Now Playing BPM">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hione_bpm_info" />
        </receiver>
        <receiver
            android:name=".widget.HioneBpmTapperWidget"
            android:exported="true"
            android:label="Hione BPM Tapper">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hione.launcher.BPM_TAP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hione_bpm_tapper_info" />
        </receiver>
        <receiver
            android:name=".widget.HioneBpmComboWidget"
            android:exported="true"
            android:label="Hione BPM Combo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hione.launcher.BPM_TAP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hione_bpm_combo_info" />
        </receiver>
        <receiver
            android:name=".widget.HioneWeatherWidget"
            android:exported="true"
            android:label="Hione Weather">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hione_weather_info" />
        </receiver>
        <receiver
            android:name=".widget.HioneThermalWidget"
            android:exported="true"
            android:label="Hione Thermal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hione_thermal_info" />
        </receiver>
        <receiver
            android:name=".widget.HioneVolumeWidget"
            android:exported="true"
            android:label="Hione Volume">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hione.launcher.SHOW_VOLUME_HUD" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hione_volume_info" />
        </receiver>

        <!-- Holiday and season art: midnight tick, boot, clock, time zone and locale changes.
             Also posts the holiday reminders. See holiday/HolidayState.kt. -->
        <receiver
            android:name=".holiday.HolidayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Installs HioneLockscreenManager at boot so the power-button/screen state machine is
             armed even before the launcher UI is opened. -->
        <receiver
            android:name=".lockscreen.HioneLockscreenBootReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Embeddable WireGuard tunnel service. The com.wireguard.android:tunnel lib does NOT
             declare it, so the embedding app must, for the in-launcher VPN client. -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="systemExempted">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- KDE Compositing control menu (per-event transition picker + live preview).
             Exposed as its own launcher entry so it's easy to open and test. -->
        <activity
            android:name=".HioneCompositingMenuActivity"
            android:exported="true"
            android:label="KDE Compositing"
            android:theme="@style/Theme.HioneLockscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HioneCompositingPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.HioneLockscreen" />
        <activity
            android:name=".bpm.HioneFrankSnakeActivity"
            android:exported="true"
            android:label="Frank the Snake"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
</manifest>
